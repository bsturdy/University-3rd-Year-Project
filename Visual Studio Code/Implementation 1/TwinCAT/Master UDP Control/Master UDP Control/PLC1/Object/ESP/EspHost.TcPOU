    <Method Name="GetSystemInfo" Id="{2f08df1f-0f28-4879-9c11-edb04a6b2d4a}" FolderPath="ITF_EspHost\">
      <Declaration><![CDATA[METHOD GetSystemInfo : EspSystemInfo
VAR_INPUT
