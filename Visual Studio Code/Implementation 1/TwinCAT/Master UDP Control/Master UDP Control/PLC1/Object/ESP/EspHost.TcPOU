    <Method Name="IsOnline" Id="{e4cb73bc-7830-4d4e-8733-23851e68f6c4}" FolderPath="ITF_EspHost\">
      <Declaration><![CDATA[METHOD IsOnline : BOOL
VAR_INPUT
	Timeout100Ns	: ULINT;
END_VAR
VAR
	Now100Ns		: ULINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Now100Ns := F_GetSystemTime();

IF _LastReceivedTimestamp = 0 THEN
	
	_Online := FALSE;
	
ELSIF Now100Ns - _LastReceivedTimestamp <= Timeout100Ns THEN
	
	_Online := TRUE;
	
ELSE
	
	_Online := FALSE;
	
END_IF

IsOnline := _Online;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetPacketType" Id="{1c42e45e-5780-4704-8339-02500e9ebdcb}" FolderPath="ITF_EspHost\">
      <Declaration><![CDATA[METHOD SetPacketType : BOOL
VAR_INPUT
	PacketType	: BYTE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Data.PacketType = 0 THEN
	
	_Data.PacketType := PacketType;
	
	SetPacketType := TRUE;

END_IF

RETURN;]]></ST>
      </Implementation>
    </Method>
