    <Method Name="SetUID" Id="{518ae377-b86c-4bdb-ac7b-f06adc4eba5e}" FolderPath="ITF_EspHost\">
      <Declaration><![CDATA[METHOD SetUID : BOOL
VAR_INPUT
	UID	: ULINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Data.SlaveUid = 0 THEN
	
	_Data.SlaveUid := UID;
	
	SetUID := TRUE;

END_IF

RETURN;]]></ST>
      </Implementation>
    </Method>
    <Method Name="UpdateMetadata" Id="{139b3c3d-2898-4d80-819a-1c7ff810c5c8}" FolderPath="ITF_EspHost\">
      <Declaration><![CDATA[METHOD UpdateMetadata : BOOL
VAR_INPUT
	Data	: EspPacketHeader;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF MEMCPY(ADR(_Data), ADR(Data), 48) = 48 THEN
	
	_PacketsReceivedCount := _PacketsReceivedCount + 1;	

	_LastReceivedTimestamp := F_GetSystemTime();
	IF _FirstReceivedTimestamp = 0 THEN
		
		_FirstReceivedTimestamp := _LastReceivedTimestamp;
		
	END_IF

	UpdateMetadata := TRUE;
	
ELSE
	
	UpdateMetadata := FALSE;

END_IF


// IF Data.SenderTimestampUs <> 0 THEN
// 	
// 	_Data.SenderTimestampUs := Data.SenderTimestampUs;
// 
// END_IF
// 
// IF Data.PrevCycleTimeUs <> 0 THEN
// 	
// 	_Data.PrevCycleTimeUs := Data.PrevCycleTimeUs;
// 
// END_IF
// 
// UpdateMetadata := TRUE;
// 
// _PacketsReceivedCount := _PacketsReceivedCount + 1;
// 
// RETURN;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="UpdateSystemInfo" Id="{fb3dccff-8b92-4ffc-ae6b-5915512e6022}" FolderPath="ITF_EspHost\">
      <Declaration><![CDATA[METHOD UpdateSystemInfo : BOOL
VAR_INPUT
	PayloadAddress	: PVOID;
	PayloadLength	: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF PayloadAddress = 0 OR PayloadLength < SIZEOF(_SystemInfo) THEN
	
	UpdateSystemInfo := FALSE;
	RETURN;
	
END_IF

IF MEMCPY(ADR(_SystemInfo), PayloadAddress, SIZEOF(_SystemInfo)) = SIZEOF(_SystemInfo) THEN
	
	UpdateSystemInfo := TRUE;
	
ELSE
	
	UpdateSystemInfo := FALSE;
	
END_IF
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
